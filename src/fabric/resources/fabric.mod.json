{
  "schemaVersion": 1,
  "id": "cinematic",
  "version": "${version}",
  "name": "Cinematic Interactions",
  "description": "First-person cinematic scenes instead of block windows: craft right on the table top, load the furnace by hand, forge at the anvil, read the book on a lectern, sit down by the fire.",
  "authors": ["Southware"],
  "license": "MIT",
  "icon": "cinematic_logo.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.dyslexic.cinematic.Cinematic"],
    "client": ["dev.dyslexic.cinematic.client.CinematicClient"],
    "modmenu": ["dev.dyslexic.cinematic.client.ModMenuIntegration"],
    "jei_mod_plugin": ["dev.dyslexic.cinematic.client.compat.jei.CinematicJeiPlugin"]
  },
  "mixins": ["cinematic.fabric.mixins.json"],
  "accessWidener": "cinematic.accesswidener",
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": ">=${fabric_api_min}"
  },
  "suggests": {"modmenu": "*"}
}
