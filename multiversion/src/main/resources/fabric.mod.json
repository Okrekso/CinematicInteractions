{
  "schemaVersion": 1,
  "id": "cinematic",
  "version": "${version}",
  "name": "Cinematic Interactions",
  "description": "First-person cinematic interactions with crafting tables, furnaces and other workstations.",
  "authors": [
    "Southware"
  ],
  "license": "MIT",
  "icon": "cinematic_logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.dyslexic.cinematic.Cinematic"
    ],
    "client": [
      "dev.dyslexic.cinematic.client.CinematicClient"
    ],
    "modmenu": [
      "dev.dyslexic.cinematic.client.ModMenuIntegration"
    ],
    "jei_mod_plugin": [
      "dev.dyslexic.cinematic.client.compat.jei.CinematicJeiPlugin"
    ]
  },
  "mixins": [
    "cinematic.fabric.mixins.json"
  ],
  "accessWidener": "cinematic.accesswidener",
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": ">=${fabric_api}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
