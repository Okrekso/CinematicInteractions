{
  "schemaVersion": 1,
  "id": "cinematic",
  "version": "${version}",
  "name": "Cinematic Interactions",
  "description": "First-person cinematic interactions with crafting tables, furnaces and other workstations.",
  "authors": ["DyslexicCreate"],
  "license": "MIT",
  "icon": "cinematic_logo.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.dyslexic.cinematic.Cinematic"],
    "client": ["dev.dyslexic.cinematic.client.CinematicClient"],
    "modmenu": ["dev.dyslexic.cinematic.client.ModMenuIntegration"]
  },
  "mixins": ["cinematic.fabric.mixins.json"],
  "accessWidener": "cinematic.accesswidener",
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "java": ">=21",
    "fabric-api": ">=${api}"
  },
  "suggests": {"cloth-config": "*", "modmenu": "*"}
}
